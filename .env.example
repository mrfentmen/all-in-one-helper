# All-in-One Helper — ENV template
# Copy to .env (never commit .env) — Cloudflare Pages env vars override this in production

# Cloudflare — for Wrangler deploys if needed
CLOUDFLARE_API_TOKEN=your_token_here
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# AdSense — paste after approval
ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Buy Me a Coffee — slug already configured
BMC_SLUG=contactae2b
BMC_COLOR=#FFDD00
