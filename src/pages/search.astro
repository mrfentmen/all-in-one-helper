---
import Layout from '../layouts/Layout.astro';
import { tools } from '../data/tools';
const q = Astro.url.searchParams.get('q') || '';
const lowerQ = q.toLowerCase();
const results = !q ? [] : tools.filter(t => 
  t.title.toLowerCase().includes(lowerQ) ||
  t.description.toLowerCase().includes(lowerQ) ||
  t.slug.includes(lowerQ)
).slice(0, 20);
---
<Layout title={q ? `Search: ${q}` : 'Search tools'} description={`Search ${tools.length} private tools`}>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-black tracking-tight">Search tools</h1>
    <p class="text-sm text-slate-600 mt-2">Find among {tools.length} tools - all run in your browser, no upload.</p>
    <form action="/search" method="get" class="mt-6 flex gap-2">
      <input name="q" value={q} placeholder="Try gif, pdf, ocr, base64..." class="flex-1 border border-slate-200 rounded-full px-4 py-3 text-sm outline-none focus:border-slate-900" autofocus />
      <button class="bg-slate-900 text-white px-6 py-3 rounded-full text-sm font-bold">Search</button>
    </form>

    <div class="mt-4 flex gap-2 text-xs">
      <span class="text-slate-500">Try:</span>
      <a href="/search?q=pdf" class="underline">pdf</a>
      <a href="/search?q=gif" class="underline">gif</a>
      <a href="/search?q=image" class="underline">image</a>
      <a href="/search?q=base64" class="underline">base64</a>
    </div>

    <div class="mt-6 h-[70px] rounded-xl border-2 border-dashed border-slate-900 bg-[#FFDD00] grid place-items-center text-center p-2"><div><div class="font-black text-sm">Your Ad Here</div><div class="text-xs">Contact <a href="mailto:contactae2000@gmail.com" class="underline">contactae2000@gmail.com</a> - $50/mo</div></div></div>
    <div class="mt-2 h-[60px] rounded-xl border-2 border-dashed border-slate-900 bg-[#FFDD00] grid place-items-center text-center text-xs p-2"><div><span class="font-black">Your ad here</span> - Contact <a href="mailto:contactae2000@gmail.com" class="underline">contactae2000@gmail.com</a> - $50/mo</div></div>

    {q && (
      <div class="mt-8">
        <div class="text-sm font-bold">{results.length} results for "{q}"</div>
        <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {results.map(t => (
            <a href={`/tools/${t.slug}`} class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-slate-900 hover:shadow-md transition flex flex-col">
              <div class="flex items-start justify-between">
                <div class="w-10 h-10 rounded-xl bg-slate-900 text-white grid place-items-center text-lg">{t.icon}</div>
                <span class="text-[10px] font-bold tracking-widest bg-slate-900 text-white px-2 py-1 rounded-full">{t.category.toUpperCase()}</span>
              </div>
              <div class="mt-4 font-bold">{t.title}</div>
              <div class="mt-1 text-sm text-slate-600 line-clamp-2">{t.description}</div>
              <div class="mt-4 text-xs font-bold"><span class="bg-[#FFDD00] border border-black px-3 py-1.5 rounded-full">Open →</span></div>
            </a>
          ))}
        </div>
        {results.length===0 && <div class="mt-6 text-center text-sm text-slate-500">No tools found for "{q}". Try pdf, image, gif, or <a href="/" class="underline">browse all</a>.</div>}
      </div>
    )}

    {!q && (
      <div class="mt-8">
        <div class="text-sm font-bold">All tools</div>
        <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {tools.slice(0,12).map(t => (
            <a href={`/tools/${t.slug}`} class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-slate-900 flex flex-col">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-white grid place-items-center">{t.icon}</div>
              <div class="mt-3 font-bold text-sm">{t.title}</div>
              <div class="text-xs text-slate-600 line-clamp-2">{t.description}</div>
            </a>
          ))}
        </div>
        <a href="/" class="mt-4 inline-block text-sm underline">View all {tools.length} →</a>
      </div>
    )}
  </div>
</Layout>
