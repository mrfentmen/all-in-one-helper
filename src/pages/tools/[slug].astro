      const val=parseFloat(unitVal.value)||0;
      const from=unitFrom.value, to=unitTo.value;
      let res=val;
      if(from==='km'&&to==='m') res=val*1000;
      else if(from==='m'&&to==='km') res=val/1000;
      else if(from==='lb'&&to==='kg') res=val*0.453592;
      else if(from==='kg'&&to==='lb') res=val/0.453592;
      else if(from==='c'&&to==='f') res=val*9/5+32;
