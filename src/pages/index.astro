---
import Layout from '../layouts/Layout.astro';
import { tools, categories } from '../data/tools';
const total = tools.length;
---

<Layout title={`Free Tools - ${total} Private, No Upload`} description={`${total} free tools that run 100% in your browser. Merge PDFs, compress images, remove backgrounds, GIF maker, OCR, and more. No upload, no paywall.`}>
  <section class="max-w-6xl mx-auto px-4 pt-10 pb-6">
    <div class="grid lg:grid-cols-[1.2fr_0.8fr] gap-8 items-center">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-bold tracking-widest text-slate-500 border border-slate-200 dark:border-slate-700 rounded-full px-3 py-1 bg-white">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          100% CLIENT-SIDE · ZERO UPLOADS · 95 PAGES MAX
        </div>
        <h1 class="mt-4 text-4xl sm:text-5xl font-black tracking-tight leading-[0.95]">
          Free tools<br />
          <span class="text-slate-400">without</span> the catch
        </h1>
        <p class="mt-4 text-[15px] leading-relaxed text-slate-600 dark:text-slate-400 max-w-xl">We got tired of paywalls and uploads. So we rebuilt the good stuff to run right in your browser. No server waiting, no watermarks. You can check yourself in your Network tab: <span class="font-semibold text-slate-900">zero bytes uploaded.</span></p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#tools" class="bg-slate-900 text-white px-6 py-3 rounded-full font-bold text-sm hover:bg-black transition">Browse {total} tools →</a>
          <a href="https://www.buymeacoffee.com/contactae2b" target="_blank" class="bg-[#FFDD00] text-black border-2 border-black px-6 py-3 rounded-full font-bold text-sm">☕ Buy me a coffee</a>
        </div>
        <div class="mt-6 flex items-center gap-4 text-xs text-slate-500">
          <span class="flex items-center gap-1.5"><span class="w-5 h-5 rounded-full bg-emerald-100 grid place-items-center">✓</span> No signup needed</span>
          <span class="flex items-center gap-1.5"><span class="w-5 h-5 rounded-full bg-emerald-100 grid place-items-center">✓</span> No watermarks, ever</span>
          <span class="flex items-center gap-1.5"><span class="w-5 h-5 rounded-full bg-emerald-100 grid place-items-center">✓</span> Works offline too</span>
        </div>
      </div>
      <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[24px] p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <div class="text-sm font-bold">Try instantly</div>
          <div class="text-xs text-emerald-600 font-semibold bg-emerald-50 px-2 py-1 rounded-full">No upload</div>
        </div>
        <div id="tryDropzone" class="mt-4 border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-2xl p-8 text-center bg-[#FCFCF9] dark:bg-slate-900 hover:border-slate-900 hover:bg-white transition cursor-pointer">
          <input id="tryFileInput" type="file" class="hidden" multiple accept=".pdf,image/*,video/*" />
          <div class="w-12 h-12 mx-auto rounded-2xl bg-slate-900 text-white grid place-items-center text-xl">⬆</div>
          <div class="mt-3 font-bold">Drop files here or click to browse</div>
          <div class="text-xs text-slate-500 mt-1">PDFs, images, video - stays on your device - instant</div>
          <div class="mt-4 grid grid-cols-3 gap-2 text-xs">
            <a href="/tools/merge-pdf" class="bg-slate-900 text-white px-3 py-2 rounded-full font-semibold hover:bg-black transition text-center">Merge PDF</a>
            <a href="/tools/gif-maker" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 px-3 py-2 rounded-full font-semibold hover:border-slate-900 transition text-center">GIF Maker</a>
            <a href="/tools/ocr-image" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 px-3 py-2 rounded-full font-semibold hover:border-slate-900 transition text-center">OCR</a>
          </div>
          <div id="tryHint" class="mt-3 text-[11px] text-emerald-600 font-medium hidden">Got it! Redirecting to tool...</div>
        </div>
        <div class="mt-4 flex gap-2">
          <input id="search" placeholder={`Search ${total} tools... (e.g. gif, pdf, ocr)`} class="flex-1 border border-slate-200 dark:border-slate-700 rounded-full px-4 py-2.5 text-sm outline-none focus:border-slate-900 dark:focus:border-slate-300 bg-white dark:bg-slate-800" />
        </div>
        <div class="mt-3 text-[11px] text-slate-500">Popular: <a class="underline" href="/tools/merge-pdf">merge pdf</a> · <a class="underline" href="/tools/gif-maker">gif maker</a> · <a class="underline" href="/tools/ocr-image">ocr</a></div>
      </div>
    </div>
    <div class="ad-slot" class="mt-8 h-[90px] border border-dashed border-slate-300 rounded-xl grid place-items-center text-slate-400 text-sm bg-white">
Your Ad Here - Contact contactae2000@gmail.com - $50/mo
    </div>
  </section>

  <section id="tools" class="max-w-6xl mx-auto px-4 pb-12">
    <div id="favRow" class="hidden mb-6">
      <div class="flex items-center gap-2 text-sm font-bold"><span>⭐ Favorites</span><span class="text-xs font-normal text-slate-500 dark:text-slate-400">Starred tools (cached)</span></div>
      <div id="favGrid" class="mt-3 grid sm:grid-cols-3 gap-3"></div>
    </div>
    <div id="recentRow" class="hidden mb-6">
      <div class="flex items-center gap-2 text-sm font-bold"><span>⏱ Continue</span><span class="text-xs font-normal text-slate-500 dark:text-slate-400">Your recent tools (cached locally)</span></div>
      <div id="recentGrid" class="mt-3 grid sm:grid-cols-3 gap-3"></div>
    </div>

    <div class="flex items-center justify-between">
      <h2 class="font-black text-xl tracking-tight">All tools</h2>
      <span id="toolCount" class="text-xs font-bold tracking-widest text-slate-500 border border-slate-200 dark:border-slate-700 rounded-full px-3 py-1 bg-white">{total} TOOLS · $0 · NO UPLOAD</span>
    </div>

    <div class="mt-4 sticky top-[64px] z-20 bg-[#FCFCF9]/80 backdrop-blur-md py-2 -mx-4 px-4 border-y border-slate-200">
      <div class="flex gap-2 overflow-x-auto scrollbar-none" id="tabs" role="tablist">
        <button data-tab="all" class="tab whitespace-nowrap bg-slate-900 text-white px-4 py-2 rounded-full text-sm font-bold">All {total}</button>
        <button data-tab="pdf" class="tab whitespace-nowrap bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 px-4 py-2 rounded-full text-sm font-bold">PDF {tools.filter(t=>t.category==='pdf').length}</button>
        <button data-tab="image" class="tab whitespace-nowrap bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 px-4 py-2 rounded-full text-sm font-bold">Image {tools.filter(t=>t.category==='image').length}</button>
        <button data-tab="video" class="tab whitespace-nowrap bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 px-4 py-2 rounded-full text-sm font-bold">Video {tools.filter(t=>t.category==='video').length}</button>
        <button data-tab="utility" class="tab whitespace-nowrap bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 px-4 py-2 rounded-full text-sm font-bold">Utility {tools.filter(t=>t.category==='utility').length}</button>
      </div>
    </div>

    <div id="skeletonGrid" class="mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {Array.from({length: 6}).map(()=> (
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5">
          <div class="flex justify-between"><div class="w-10 h-10 rounded-xl bg-slate-200 dark:bg-slate-800 animate-pulse"></div><div class="w-12 h-6 rounded-full bg-slate-200 dark:bg-slate-800 animate-pulse"></div></div>
          <div class="mt-4 h-4 bg-slate-200 rounded animate-pulse w-3/4"></div>
          <div class="mt-2 h-3 bg-slate-100 dark:bg-slate-800 rounded animate-pulse"></div>
          <div class="mt-4 h-8 bg-slate-200 rounded-full animate-pulse w-24"></div>
        </div>
      ))}
    </div>

    <div id="toolsGrid" class="hidden mt-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-4" style="content-visibility:auto; contain: layout;">
      {tools.map(t => (
        <a href={`/tools/${t.slug}`} data-tool-card data-cat={t.category} data-title={t.title.toLowerCase()} data-desc={t.description.toLowerCase()} class="group bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 hover:border-slate-900 hover:shadow-md transition flex flex-col">
          <div class="flex items-start justify-between">
            <div class="w-10 h-10 rounded-xl bg-slate-900 dark:bg-white dark:text-slate-900 text-white grid place-items-center text-lg">{t.icon}</div>
            <button data-fav={t.slug} aria-label={`Favorite ${t.title}`} class="text-lg leading-none opacity-40 hover:opacity-100 transition" title="Star this tool">☆</button>
          </div>
          <div class="mt-4 font-bold leading-tight group-hover:underline">{t.title}</div>
          <div class="mt-1 text-sm text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-2">{t.description}</div>
          <div class="mt-4 flex items-center gap-2 text-xs font-bold">
            <span class="bg-[#FFDD00] border border-black px-3 py-1.5 rounded-full">Open →</span>
            <span class="text-slate-400">No upload</span>
          </div>
        </a>
      ))}
    </div>

    <div id="pagination" class="mt-6 flex justify-center gap-2">
      <button id="showMore" class="hidden bg-white border border-slate-900 text-slate-900 px-6 py-2 rounded-full text-sm font-bold hover:bg-slate-900 hover:text-white transition">Show 12 more</button>
      <span id="pageInfo" class="text-xs text-slate-500 self-center"></span>
    </div>

    <div id="noResults" class="hidden mt-6 text-center text-sm text-slate-500">No tools found - try another search.</div>

    <div class="mt-10 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6">
      <h3 class="font-black">Why use this instead of iLovePDF?</h3>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">iLovePDF is great, but it charges, makes you upload, and limits free use. We do the same thing with <code class="bg-slate-100 px-1.5 py-0.5 rounded">pdf-lib</code> + Canvas in browser. Faster, private, and actually free.</p>
      <div class="mt-4 grid sm:grid-cols-3 gap-3 text-sm">
        <div class="border border-slate-200 dark:border-slate-700 rounded-xl p-4 bg-[#FCFCF9]"><div class="font-bold">🔒 Private</div><div class="text-slate-600 dark:text-slate-400 text-xs mt-1">Files never leave RAM.</div></div>
        <div class="border border-slate-200 dark:border-slate-700 rounded-xl p-4 bg-[#FCFCF9]"><div class="font-bold">⚡ Fast</div><div class="text-slate-600 dark:text-slate-400 text-xs mt-1">No upload wait. Offline.</div></div>
        <div class="border border-slate-200 dark:border-slate-700 rounded-xl p-4 bg-[#FCFCF9]"><div class="font-bold">💛 Free</div><div class="text-slate-600 dark:text-slate-400 text-xs mt-1">Ad + BMC funded.</div></div>
      </div>
    </div>

    <details class="mt-8 border border-slate-200 dark:border-slate-700 rounded-2xl p-6 bg-slate-900 text-white group">
      <summary class="font-black cursor-pointer list-none flex justify-between items-center">FAQ <span class="group-open:rotate-180 transition">▾</span></summary>
      <div class="mt-4 grid sm:grid-cols-2 gap-6 text-sm">
        <div><div class="font-bold">Do you keep my files?</div><div class="text-slate-400 mt-1">Nope. There's literally no upload button to our server. Everything happens in your browser.</div></div>
        <div><div class="font-bold">Can I use it offline?</div><div class="text-slate-400 mt-1">Yep! Once it loads the first time, try airplane mode. It still works.</div></div>
        <div><div class="font-bold">Why buy you a coffee?</div><div class="text-slate-400 mt-1">Ads pay for our domain. Coffee helps us make the tools even better. <a href="https://www.buymeacoffee.com/contactae2b" class="underline text-[#FFDD00]">contactae2b</a></div></div>
        <div><div class="font-bold">Cached?</div><div class="text-slate-400 mt-1">Recent + prefs cached locally (localStorage). Clear in Privacy.</div></div>
      </div>
    </details>
  </section>

  <script is:inline>
    const toolsGrid = document.getElementById('toolsGrid');
    const skeletonGrid = document.getElementById('skeletonGrid');
    const tabs = document.querySelectorAll('.tab');
    const cards = Array.from(document.querySelectorAll('[data-tool-card]'));
    const search = document.getElementById('search');
    const showMore = document.getElementById('showMore');
    const pageInfo = document.getElementById('pageInfo');
    const noResults = document.getElementById('noResults');
    const recentRow = document.getElementById('recentRow');
    const recentGrid = document.getElementById('recentGrid');

    let activeTab = localStorage.getItem('helper_prefs') ? JSON.parse(localStorage.getItem('helper_prefs')).lastCategory || 'all' : 'all';
    let query = '';
    let visibleCount = 12;
    const PER_PAGE = 12;

    function getPrefs(){ try{ return JSON.parse(localStorage.getItem('helper_prefs')||'{}'); }catch{return{}} }
    function setPrefs(v){ localStorage.setItem('helper_prefs', JSON.stringify({...getPrefs(), ...v})); }

    // Skeleton -> real after 300ms (simulate no spinner, just shimmer)
    setTimeout(()=>{
      skeletonGrid.classList.add('hidden');
      toolsGrid.classList.remove('hidden');
      update();
    }, 300);

    // Recent (cached)
    try{
      const recent = JSON.parse(localStorage.getItem('helper_recent')||'[]');
      if(recent.length){
        recentRow.classList.remove('hidden');
        recentGrid.innerHTML = recent.slice(0,3).map(slug=>{
          const c = cards.find(x=> x.getAttribute('href')===`/tools/${slug}`);
          if(!c) return '';
          return `<a href="/tools/${slug}" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-3 flex items-center gap-3 hover:border-slate-900"><span class="w-8 h-8 rounded-lg bg-slate-900 text-white grid place-items-center">${c.querySelector('div').textContent.trim().slice(0,2)}</span><span class="font-bold text-sm">${c.dataset.title}</span></a>`;
        }).join('');
      }
    }catch{}

    function filtered(){
      return cards.filter(c=>{
        const catOk = activeTab==='all' || c.dataset.cat===activeTab;
        const qOk = !query || (c.dataset.title + ' ' + c.dataset.desc).includes(query);
        return catOk && qOk;
      });
    }

    function update(){
      const list = filtered();
      cards.forEach(c=> c.style.display='none');
      if(!list.length){
        noResults.classList.remove('hidden');
        showMore.classList.add('hidden');
        pageInfo.textContent='';
        return;
      }
      noResults.classList.add('hidden');
      list.slice(0, visibleCount).forEach(c=> c.style.display='');
      pageInfo.textContent = `Showing ${Math.min(visibleCount, list.length)} of ${list.length}`;
      showMore.classList.toggle('hidden', list.length <= visibleCount);
      // Cache last tab
      setPrefs({lastCategory: activeTab});
    }

    tabs.forEach(b=>{
      if(b.dataset.tab===activeTab){ b.classList.add('bg-slate-900','text-white'); b.classList.remove('bg-white','border'); }
      b.addEventListener('click', ()=>{
        tabs.forEach(x=>{ x.classList.remove('bg-slate-900','text-white'); x.classList.add('bg-white','border'); });
        b.classList.add('bg-slate-900','text-white'); b.classList.remove('bg-white','border');
        activeTab=b.dataset.tab;
        visibleCount=PER_PAGE;
        update();
      });
    });

    let t;
    search?.addEventListener('input', e=>{
      clearTimeout(t);
      // Show skeleton while typing (debounced)
      skeletonGrid.classList.remove('hidden');
      toolsGrid.classList.add('hidden');
      t=setTimeout(()=>{
        query=e.target.value.toLowerCase().trim();
        visibleCount=PER_PAGE;
        skeletonGrid.classList.add('hidden');
        toolsGrid.classList.remove('hidden');
        update();
      }, 150);
    });

    showMore?.addEventListener('click', ()=>{
      visibleCount+=PER_PAGE;
      update();
    });

    // Favorites
    function getFavs(){ try{ return JSON.parse(localStorage.getItem('helper_favs')||'[]'); }catch{return[]} }
    function renderFavs(){
      const favs = getFavs();
      document.querySelectorAll('[data-fav]').forEach(b=>{
        const on = favs.includes(b.dataset.fav);
        b.textContent = on ? '⭐' : '☆';
        b.classList.toggle('opacity-100', on);
        b.classList.toggle('opacity-40', !on);
      });
      const row = document.getElementById('favRow');
      const grid = document.getElementById('favGrid');
      if(favs.length){
        row.classList.remove('hidden');
        grid.innerHTML = favs.slice(0,6).map(slug=>{
          const c = cards.find(x=> x.getAttribute('href')===`/tools/${slug}`);
          if(!c) return '';
          return `<a href="/tools/${slug}" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-3 flex items-center gap-3 hover:border-slate-900 dark:hover:border-slate-300"><span class="w-8 h-8 rounded-lg bg-slate-900 dark:bg-white dark:text-slate-900 text-white grid place-items-center">${c.querySelector('div').textContent.trim().slice(0,2)}</span><span class="font-bold text-sm">${c.dataset.title}</span></a>`;
        }).join('');
      } else { row.classList.add('hidden'); }
    }
    document.addEventListener('click', e=>{
      const btn = e.target.closest('[data-fav]');
      if(!btn) return;
      e.preventDefault(); e.stopPropagation();
      const slug = btn.dataset.fav;
      let favs = getFavs();
      if(favs.includes(slug)) favs = favs.filter(s=>s!==slug);
      else { favs.unshift(slug); favs = favs.slice(0,6); }
      localStorage.setItem('helper_favs', JSON.stringify(favs));
      renderFavs();
    });
    renderFavs();

    // History (IndexedDB via localStorage fallback - last 10 runs)
    function pushHistory(entry){
      try{
        const h = JSON.parse(localStorage.getItem('helper_history')||'[]');
        h.unshift({...entry, time: Date.now()});
        localStorage.setItem('helper_history', JSON.stringify(h.slice(0,10)));
      }catch{}
    }
    window.pushHistory = pushHistory;

    // Bulk queue badge (sessionStorage)
    try{
      const q = JSON.parse(sessionStorage.getItem('helper_queue')||'[]');
      if(q.length){
        const badge = document.createElement('a');
        badge.href = '/tools/merge-pdf';
        badge.className = 'fixed bottom-4 right-4 z-50 bg-slate-900 dark:bg-white dark:text-slate-900 text-white px-4 py-2 rounded-full text-xs font-bold shadow-lg';
        badge.textContent = `📦 ${q.length} queued`;
        document.body.appendChild(badge);
      }
    }catch{}

    // Try instantly dropzone - functional
    const tryDropzone = document.getElementById('tryDropzone');
    const tryFileInput = document.getElementById('tryFileInput');
    const tryHint = document.getElementById('tryHint');
    function handleTryFiles(files){
      if(!files.length) return;
      const f = files[0];
      const type = f.type;
      let target = '/tools/merge-pdf';
      if(type.startsWith('image/')){
        if(type.includes('gif')) target = '/tools/gif-maker';
        else if(files.length>1) target = '/tools/gif-maker';
        else target = '/tools/compress-image';
      } else if(type.startsWith('video/')){
        target = '/tools/video-compress';
      } else if(type==='application/pdf'){
        target = '/tools/merge-pdf';
      } else {
        target = '/tools/ocr-image';
      }
      tryHint.classList.remove('hidden');
      tryHint.textContent = `Got ${files.length} file(s) - opening ${target.split('/').pop()}...`;
      setTimeout(()=> location.href=target, 600);
    }
    tryDropzone?.addEventListener('click', ()=> tryFileInput.click());
    tryDropzone?.addEventListener('dragover', e=>{ e.preventDefault(); tryDropzone.classList.add('border-slate-900','bg-white'); });
    tryDropzone?.addEventListener('dragleave', ()=> tryDropzone.classList.remove('border-slate-900','bg-white'));
    tryDropzone?.addEventListener('drop', e=>{ e.preventDefault(); tryDropzone.classList.remove('border-slate-900','bg-white'); handleTryFiles(Array.from(e.dataTransfer.files)); });
    tryFileInput?.addEventListener('change', e=> handleTryFiles(Array.from(e.target.files)));

    // Initial
    update();
  </script>
</Layout>
