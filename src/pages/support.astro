---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Support" description="Support All-in-One Helper via Buy Me a Coffee.">
<div class="max-w-3xl mx-auto px-4 py-12 text-center">
<h1 class="text-3xl font-black">Support free tools ☕</h1>
<p class="mt-4 text-slate-600">We run on $0 + domain. Your coffee funds WASM improvements.</p>
<a href="https://www.buymeacoffee.com/contactae2b" target="_blank" class="mt-6 inline-flex bg-[#FFDD00] border-2 border-black px-8 py-3 rounded-full font-black">Buy me a coffee - contactae2b</a>
<div class="mt-8 border-2 border-dashed border-slate-300 rounded-xl p-6 bg-white">BMC Button will appear here<br /><script type="text/javascript" src="https://cdnjs.buymeacoffee.com/1.0.0/button.prod.min.js" data-name="bmc-button" data-slug="contactae2b" data-color="#FFDD00" data-emoji="" data-font="Lato" data-text="Buy me a coffee" data-outline-color="#000000" data-font-color="#000000" data-coffee-color="#ffffff"></script></div>
</div>
</Layout>
