---
interface Props { class?: string; lines?: number; }
const { class: cls = "", lines = 1 } = Astro.props;
---
{Array.from({length: lines}).map((_, i) => (
  <div class={`animate-pulse bg-gradient-to-r from-slate-200 via-slate-100 to-slate-200 bg-[length:200%_100%] rounded-xl ${cls}`} style="animation: shimmer 1.5s infinite;" aria-busy="true" aria-label="Loading"></div>
))}
<style>
@keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
</style>
